{
  "manifest_version": 3,
  "name": "Yuze-agent",
  "version": "0.7.19",
  "description": "浏览器内 AI agent：本机模型 + 页面操控 + 技能 + MCP + 文件生成",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "debugger",
    "tabs",
    "storage",
    "activeTab",
    "downloads",
    "downloads.open",
    "scripting",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Yuze-agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}